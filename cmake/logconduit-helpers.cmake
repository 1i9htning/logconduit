include_guard(GLOBAL)

# These helpers operate on UTF-8/LF text, not arbitrary binary/preprocessed C.
function(_logconduit_arguments prefix)
  if(NOT "${${prefix}_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${${prefix}_KEYWORDS_MISSING_VALUES}" STREQUAL "")
    message(FATAL_ERROR "logconduit: unknown arguments or missing keyword values: ${${prefix}_UNPARSED_ARGUMENTS};${${prefix}_KEYWORDS_MISSING_VALUES}")
  endif()
  foreach(key IN LISTS ARGN)
    if(NOT DEFINED ${prefix}_${key} OR "${${prefix}_${key}}" STREQUAL "")
      message(FATAL_ERROR "logconduit: ${key} is required and must not be empty")
    endif()
  endforeach()
endfunction()

function(_logconduit_prefixes type_prefix macro_prefix)
  foreach(value IN ITEMS "${type_prefix}" "${macro_prefix}")
    if(NOT value MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR value MATCHES "__")
      message(FATAL_ERROR "logconduit: prefixes must be letter-led ASCII identifiers without double underscores")
    endif()
  endforeach()
  if(type_prefix STREQUAL "logconduit" OR macro_prefix STREQUAL "LOGCONDUIT")
    message(FATAL_ERROR "logconduit: use library-local prefixes, not logconduit / LOGCONDUIT")
  endif()
endfunction()

function(_logconduit_render output filename type_prefix macro_prefix public_header)
  _logconduit_prefixes("${type_prefix}" "${macro_prefix}")
  if(NOT TARGET logconduit::logconduit)
    message(FATAL_ERROR "logconduit: load the SDK target before using generation helpers")
  endif()
  get_target_property(template_dir logconduit::logconduit _LOGCONDUIT_TEMPLATE_DIR)
  if(NOT template_dir OR NOT EXISTS "${template_dir}/${filename}")
    message(FATAL_ERROR "logconduit: cannot locate SDK template ${filename}")
  endif()
  set(template "${template_dir}/${filename}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${template}")
  file(READ "${template}" text)
  set(TYPE_PREFIX "${type_prefix}")
  set(MACRO_PREFIX "${macro_prefix}")
  set(PUBLIC_HEADER "${public_header}")
  if(filename STREQUAL "core.h.in" OR filename STREQUAL "cpp-adapter.hpp.in")
    set(slots TYPE_PREFIX MACRO_PREFIX)
  elseif(filename STREQUAL "c-adapter.h.in")
    set(slots TYPE_PREFIX)
  elseif(filename STREQUAL "c-adapter.c.in" OR filename STREQUAL "cpp-adapter.cpp.in")
    set(slots TYPE_PREFIX PUBLIC_HEADER)
  elseif(filename STREQUAL "protocol-config.h.in")
    set(slots TYPE_PREFIX MACRO_PREFIX PUBLIC_HEADER)
  else()
    message(FATAL_ERROR "logconduit: unsupported template ${filename}")
  endif()
  set(unchecked "${text}")
  foreach(slot IN LISTS slots)
    string(FIND "${text}" "@${slot}@" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "logconduit: ${filename} requires @${slot}@")
    endif()
  endforeach()
  # A template need not use every supported substitution (e.g. C declarations
  # have no macro prefix), but any substitution it does use must be known.
  foreach(slot IN ITEMS TYPE_PREFIX MACRO_PREFIX PUBLIC_HEADER)
    string(REPLACE "@${slot}@" "" unchecked "${unchecked}")
  endforeach()
  # Doxygen @brief and @details are documentation commands, not placeholders.
  # Other documentation commands should use the backslash form.
  string(REGEX REPLACE "@(brief|details)([ \t\r\n])" "\\2" unchecked "${unchecked}")
  if(unchecked MATCHES "@")
    message(FATAL_ERROR "logconduit: unknown/malformed placeholder in ${filename}")
  endif()
  string(CONFIGURE "${text}" rendered @ONLY)
  string(REGEX REPLACE "@(brief|details)([ \t\r\n])" "\\2" checked "${rendered}")
  if(checked MATCHES "@")
    message(FATAL_ERROR "logconduit: unresolved placeholder in ${filename}")
  endif()
  set(${output} "${rendered}" PARENT_SCOPE)
endfunction()

function(_logconduit_write path content)
  if(IS_SYMLINK "${path}")
    message(FATAL_ERROR "logconduit: refusing to overwrite symlink ${path}")
  endif()
  if(EXISTS "${path}")
    file(READ "${path}" previous)
    if(previous STREQUAL content)
      return()
    endif()
  endif()
  get_filename_component(directory "${path}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(WRITE "${path}" "${content}")
endfunction()

function(logconduit_generate_protocol)
  cmake_parse_arguments(PARSE_ARGV 0 LC "" "OUTPUT;TYPE_PREFIX;MACRO_PREFIX" "")
  _logconduit_arguments(LC OUTPUT TYPE_PREFIX MACRO_PREFIX)
  get_filename_component(path "${LC_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  _logconduit_render(fragment core.h.in "${LC_TYPE_PREFIX}" "${LC_MACRO_PREFIX}" "")
  _logconduit_write("${path}" "#pragma once\n#include <stdint.h>\n\n${fragment}")
endfunction()

# Find an exact, unique full line, returning its byte offset in LF text.
function(_logconduit_marker output text marker)
  set(padded "\n${text}\n")
  set(needle "\n${marker}\n")
  string(FIND "${padded}" "${needle}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "logconduit: missing complete marker line: ${marker}")
  endif()
  math(EXPR next "${position} + 1")
  string(SUBSTRING "${padded}" ${next} -1 remainder)
  string(FIND "${remainder}" "${needle}" duplicate)
  if(NOT duplicate EQUAL -1)
    message(FATAL_ERROR "logconduit: duplicate marker line: ${marker}")
  endif()
  set(${output} "${position}" PARENT_SCOPE)
endfunction()

function(logconduit_embed_protocol)
  cmake_parse_arguments(PARSE_ARGV 0 LC ""
    "HEADER;BEGIN_MARKER;END_MARKER;TYPE_PREFIX;MACRO_PREFIX" "")
  _logconduit_arguments(LC HEADER BEGIN_MARKER END_MARKER TYPE_PREFIX MACRO_PREFIX)
  if(LC_BEGIN_MARKER STREQUAL LC_END_MARKER
      OR LC_BEGIN_MARKER MATCHES "[\r\n]" OR LC_END_MARKER MATCHES "[\r\n]")
    message(FATAL_ERROR "logconduit: markers must be different, nonempty single lines")
  endif()
  get_filename_component(path "${LC_HEADER}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  if(IS_SYMLINK "${path}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "logconduit: HEADER must be an existing regular, non-symlink file")
  endif()
  file(READ "${path}" original)
  if(original MATCHES "\r")
    message(FATAL_ERROR "logconduit: embed_protocol requires LF text; convert CRLF explicitly first")
  endif()
  _logconduit_marker(begin "${original}" "${LC_BEGIN_MARKER}")
  _logconduit_marker(end "${original}" "${LC_END_MARKER}")
  if(NOT begin LESS end)
    message(FATAL_ERROR "logconduit: BEGIN_MARKER must precede END_MARKER")
  endif()
  _logconduit_render(fragment core.h.in "${LC_TYPE_PREFIX}" "${LC_MACRO_PREFIX}" "")
  string(LENGTH "${LC_BEGIN_MARKER}" marker_length)
  math(EXPR content_start "${begin} + ${marker_length} + 1")
  string(SUBSTRING "${original}" 0 ${content_start} prefix)
  string(SUBSTRING "${original}" ${end} -1 suffix)
  if(NOT fragment MATCHES "\n$")
    string(APPEND fragment "\n")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  _logconduit_write("${path}" "${prefix}${fragment}${suffix}")
endfunction()

# Validate against the original header before any of its segments are changed.
function(_logconduit_segment begin_output end_output text name)
  set(begin_marker "// [SEG] logconduit:${name}")
  set(end_marker "// [ENDSEG] logconduit:${name}")
  _logconduit_marker(begin "${text}" "${begin_marker}")
  _logconduit_marker(end "${text}" "${end_marker}")
  if(NOT begin LESS end)
    message(FATAL_ERROR "logconduit: ${name} BEGIN marker must precede END marker")
  endif()
  string(LENGTH "${begin_marker}" length)
  math(EXPR start "${begin} + ${length} + 1")
  set(${begin_output} "${start}" PARENT_SCOPE)
  set(${end_output} "${end}" PARENT_SCOPE)
endfunction()

function(_logconduit_replace_segment output text start end fragment)
  string(SUBSTRING "${text}" 0 ${start} prefix)
  string(SUBSTRING "${text}" ${end} -1 suffix)
  if(NOT fragment MATCHES "\n$")
    string(APPEND fragment "\n")
  endif()
  set(${output} "${prefix}${fragment}${suffix}" PARENT_SCOPE)
endfunction()

# All generated implementation/configuration files live in the SDK source tree.
# Never silently fall back to the consumer's build directory.
function(_logconduit_prepare_output directory)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}"
    RESULT_VARIABLE result ERROR_VARIABLE detail)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "logconduit: SDK src directory is not writable: ${directory}\n${detail}")
  endif()
  string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
  set(probe "${directory}/.logconduit-write-check-${nonce}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${probe}"
    RESULT_VARIABLE result ERROR_VARIABLE detail)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "logconduit: SDK src directory is not writable: ${directory}\n${detail}")
  endif()
  file(REMOVE "${probe}")
endfunction()

function(logconduit_configure_target)
  cmake_parse_arguments(PARSE_ARGV 0 LC ""
    "TARGET;CONFIG_HEADER;PUBLIC_HEADER;HEADER;TYPE_PREFIX;MACRO_PREFIX;PUBLIC_INCLUDE_DIR;ADAPTER" "")
  _logconduit_arguments(LC TARGET PUBLIC_HEADER TYPE_PREFIX MACRO_PREFIX)
  _logconduit_prefixes("${LC_TYPE_PREFIX}" "${LC_MACRO_PREFIX}")
  if(NOT TARGET "${LC_TARGET}")
    message(FATAL_ERROR "logconduit: TARGET must already exist")
  endif()
  if(NOT TARGET logconduit::logconduit)
    message(FATAL_ERROR "logconduit: load the SDK target before using generation helpers")
  endif()
  get_target_property(alias "${LC_TARGET}" ALIASED_TARGET)
  get_target_property(imported "${LC_TARGET}" IMPORTED)
  get_target_property(kind "${LC_TARGET}" TYPE)
  get_target_property(configured "${LC_TARGET}" _LOGCONDUIT_CONFIGURED)
  if(alias OR imported OR NOT kind MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
    message(FATAL_ERROR "logconduit: configure an owned concrete target, not an alias/imported/interface target")
  endif()
  if(configured)
    message(FATAL_ERROR "logconduit: target ${LC_TARGET} was already configured")
  endif()
  if(NOT DEFINED LC_ADAPTER)
    set(LC_ADAPTER NONE)
  endif()
  if(NOT LC_ADAPTER MATCHES "^(NONE|C|CPP)$")
    message(FATAL_ERROR "logconduit: ADAPTER must be NONE, C or CPP")
  endif()
  if(NOT LC_PUBLIC_HEADER MATCHES "^[A-Za-z0-9_./+-]+$"
      OR LC_PUBLIC_HEADER MATCHES "^/|/$" OR LC_PUBLIC_HEADER MATCHES "//"
      OR "/${LC_PUBLIC_HEADER}/" MATCHES "/[.][.]?/")
    message(FATAL_ERROR "logconduit: PUBLIC_HEADER must be a relative logical include name without traversal")
  endif()
  if(DEFINED LC_PUBLIC_INCLUDE_DIR)
    get_filename_component(public_dir "${LC_PUBLIC_INCLUDE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  else()
    set(public_dir "${CMAKE_CURRENT_SOURCE_DIR}")
  endif()
  if(DEFINED LC_HEADER)
    get_filename_component(header "${LC_HEADER}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  else()
    set(header "${public_dir}/${LC_PUBLIC_HEADER}")
  endif()
  if(IS_SYMLINK "${header}" OR NOT EXISTS "${header}" OR IS_DIRECTORY "${header}")
    message(FATAL_ERROR "logconduit: public HEADER must be an existing regular, non-symlink file: ${header}")
  endif()
  get_filename_component(header "${header}" REALPATH)
  if(header MATCHES "[\"\r\n\t;]" OR header MATCHES "\\\\")
    message(FATAL_ERROR "logconduit: public HEADER path cannot safely appear in a quoted C include (quotes, backslashes, control whitespace or semicolons): ${header}")
  endif()
  if(DEFINED LC_HEADER AND NOT DEFINED LC_PUBLIC_INCLUDE_DIR)
    # Infer the include root only when the explicit path ends in the logical
    # include name. Otherwise the caller must supply PUBLIC_INCLUDE_DIR.
    string(LENGTH "${header}" header_length)
    string(LENGTH "/${LC_PUBLIC_HEADER}" suffix_length)
    math(EXPR root_length "${header_length} - ${suffix_length}")
    if(root_length LESS 0)
      message(FATAL_ERROR "logconduit: HEADER requires a matching PUBLIC_HEADER or explicit PUBLIC_INCLUDE_DIR")
    endif()
    string(SUBSTRING "${header}" ${root_length} -1 suffix)
    if(NOT suffix STREQUAL "/${LC_PUBLIC_HEADER}")
      message(FATAL_ERROR "logconduit: HEADER requires a matching PUBLIC_HEADER or explicit PUBLIC_INCLUDE_DIR")
    endif()
    string(SUBSTRING "${header}" 0 ${root_length} public_dir)
    if(public_dir STREQUAL "")
      set(public_dir "/")
    endif()
  endif()
  if(NOT IS_DIRECTORY "${public_dir}")
    message(FATAL_ERROR "logconduit: PUBLIC_INCLUDE_DIR must be an existing directory")
  endif()
  file(READ "${header}" original)
  if(original MATCHES "\r")
    message(FATAL_ERROR "logconduit: public HEADER requires LF text; convert CRLF explicitly first")
  endif()
  _logconduit_segment(core_start core_end "${original}" core)
  _logconduit_render(core core.h.in "${LC_TYPE_PREFIX}" "${LC_MACRO_PREFIX}" "${LC_PUBLIC_HEADER}")
  _logconduit_render(config protocol-config.h.in "${LC_TYPE_PREFIX}" "${LC_MACRO_PREFIX}" "${header}")
  if(NOT LC_ADAPTER STREQUAL "NONE")
    if(LC_ADAPTER STREQUAL "C")
      set(adapter_name c_adapter)
      set(adapter_template c-adapter.h.in)
      set(implementation_name c-adapter.c)
    else()
      set(adapter_name cpp_adapter)
      set(adapter_template cpp-adapter.hpp.in)
      set(implementation_name cpp-adapter.cpp)
    endif()
    _logconduit_segment(adapter_start adapter_end "${original}" "${adapter_name}")
    if(NOT core_end LESS adapter_start AND NOT adapter_end LESS core_start)
      message(FATAL_ERROR "logconduit: core and ${adapter_name} segments must not overlap or nest")
    endif()
    _logconduit_render(adapter "${adapter_template}" "${LC_TYPE_PREFIX}" "${LC_MACRO_PREFIX}" "${LC_PUBLIC_HEADER}")
    _logconduit_render(implementation "${implementation_name}.in" "${LC_TYPE_PREFIX}" "${LC_MACRO_PREFIX}" "${header}")
    # Work backwards so the offsets of all not-yet-replaced segments stay valid.
    if(core_start LESS adapter_start)
      _logconduit_replace_segment(updated "${original}" ${adapter_start} ${adapter_end} "${adapter}")
      _logconduit_replace_segment(updated "${updated}" ${core_start} ${core_end} "${core}")
    else()
      _logconduit_replace_segment(updated "${original}" ${core_start} ${core_end} "${core}")
      _logconduit_replace_segment(updated "${updated}" ${adapter_start} ${adapter_end} "${adapter}")
    endif()
  else()
    _logconduit_replace_segment(updated "${original}" ${core_start} ${core_end} "${core}")
  endif()

  get_target_property(sdk_root logconduit::logconduit _LOGCONDUIT_SOURCE_DIR)
  if(NOT sdk_root OR NOT IS_DIRECTORY "${sdk_root}" OR NOT IS_ABSOLUTE "${sdk_root}")
    message(FATAL_ERROR "logconduit: SDK target must provide an absolute _LOGCONDUIT_SOURCE_DIR")
  endif()
  get_filename_component(sdk_root "${sdk_root}" REALPATH)
  set(directory "${sdk_root}/src")
  string(TOLOWER "${LC_TYPE_PREFIX}" file_stem)
  string(REPLACE "_" "-" file_stem "${file_stem}")
  set(config_basename "${file_stem}-protocol-config.h")
  set(config_path "${directory}/${config_basename}")
  # A small in-file ownership stamp also detects a different target/configuration
  # in another binary tree, without creating a separate manifest. Canonical
  # includes make logical PUBLIC_HEADER layouts irrelevant to output content.
  string(SHA256 identity "${LC_TARGET}\n${LC_TYPE_PREFIX}\n${LC_MACRO_PREFIX}\n${header}\n${LC_ADAPTER}")
  set(owner "// logconduit output owner: ${identity}\n")
  string(PREPEND config "${owner}")
  if(NOT LC_ADAPTER STREQUAL "NONE")
    set(implementation_path "${directory}/${file_stem}-${implementation_name}")
    string(PREPEND implementation "${owner}")
  endif()
  if(config_path MATCHES "[\"\r\n\t;]" OR config_path MATCHES "\\\\")
    message(FATAL_ERROR "logconduit: SDK configuration path cannot safely appear in a quoted C include: ${config_path}")
  endif()
  if(DEFINED LC_CONFIG_HEADER)
    # Legacy callers may name the new output explicitly, but cannot redirect
    # configuration into a build tree (or choose an arbitrary include name).
    if(NOT LC_CONFIG_HEADER STREQUAL config_basename AND NOT LC_CONFIG_HEADER STREQUAL config_path)
      message(FATAL_ERROR "logconduit: CONFIG_HEADER must be ${config_basename} or the SDK output path ${config_path}; build-tree outputs are no longer supported")
    endif()
  endif()
  string(SHA256 header_key "${header}")
  get_property(header_claimed GLOBAL PROPERTY "_LOGCONDUIT_HEADER_${header_key}" SET)
  if(header_claimed)
    get_property(header_owner GLOBAL PROPERTY "_LOGCONDUIT_HEADER_${header_key}")
    message(FATAL_ERROR "logconduit: public HEADER already claimed by target ${header_owner}: ${header}")
  endif()
  set(outputs "${config_path}")
  if(NOT LC_ADAPTER STREQUAL "NONE")
    list(APPEND outputs "${implementation_path}")
  endif()
  foreach(path IN ITEMS "${directory}")
    if(IS_SYMLINK "${path}" OR (EXISTS "${path}" AND NOT IS_DIRECTORY "${path}"))
      message(FATAL_ERROR "logconduit: SDK output directory must not be a symlink or regular file: ${path}")
    endif()
  endforeach()
  foreach(path IN LISTS outputs)
    if(IS_SYMLINK "${path}" OR IS_DIRECTORY "${path}")
      message(FATAL_ERROR "logconduit: refusing non-regular generated output: ${path}")
    endif()
    string(SHA256 output_key "${path}")
    get_property(output_claimed GLOBAL PROPERTY "_LOGCONDUIT_OUTPUT_${output_key}" SET)
    if(output_claimed)
      get_property(output_owner GLOBAL PROPERTY "_LOGCONDUIT_OUTPUT_${output_key}")
      message(FATAL_ERROR "logconduit: generated output already claimed by target ${output_owner}: ${path}")
    endif()
    if(EXISTS "${path}")
      file(READ "${path}" previous_content)
      string(FIND "${previous_content}" "${owner}" owner_position)
      if(NOT owner_position EQUAL 0)
        message(FATAL_ERROR "logconduit: generated output content conflict: ${path}\nExisting output has no matching ownership line for this target/configuration. Refusing to overwrite; remove known derived output files explicitly before regenerating.")
      endif()
    endif()
  endforeach()
  _logconduit_prepare_output("${directory}")
  _logconduit_write("${config_path}" "${config}")
  if(NOT LC_ADAPTER STREQUAL "NONE")
    _logconduit_write("${implementation_path}" "${implementation}")
  endif()
  # One write only, after every selected segment and template has been checked.
  _logconduit_write("${header}" "${updated}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${header}")
  set_property(GLOBAL PROPERTY "_LOGCONDUIT_HEADER_${header_key}" "${LC_TARGET}")
  foreach(path IN LISTS outputs)
    string(SHA256 output_key "${path}")
    set_property(GLOBAL PROPERTY "_LOGCONDUIT_OUTPUT_${output_key}" "${LC_TARGET}")
  endforeach()
  set_property(TARGET "${LC_TARGET}" PROPERTY _LOGCONDUIT_CONFIGURED TRUE)
  set_property(TARGET "${LC_TARGET}" PROPERTY _LOGCONDUIT_GENERATED_DIR "${directory}")
  target_sources("${LC_TARGET}" PRIVATE ${outputs})
  target_include_directories("${LC_TARGET}" PRIVATE "${directory}" "${public_dir}")
  target_compile_definitions("${LC_TARGET}" PRIVATE "LOGCONDUIT_PROTOCOL_CONFIG=\"${config_path}\"")
  target_link_libraries("${LC_TARGET}" PRIVATE logconduit::logconduit)
endfunction()
